# Copy this file to ".env.local" and fill in your values.
# ".env.local" is gitignored so your real secrets never get committed.
#
# Find both values in your Supabase project dashboard:
#   Project Settings → Data API  →  Project URL   (NEXT_PUBLIC_SUPABASE_URL)
#   Project Settings → API Keys   →  service_role  (NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY)

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The SECRET service_role key. Server-side only — never expose to the browser.
# (Note: it has NO NEXT_PUBLIC_ prefix precisely so Next.js keeps it server-only.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
