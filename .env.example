# Copy this file to ".env" and fill in your values.
# ".env" is gitignored so your real secrets never get committed.

# The port the server listens on (Render sets this automatically).
PORT=3000

# The public base URL used when building short links.
# Locally this is your localhost; in production it's your deployed domain.
BASE_URL=http://localhost:3000

# --- Local Postgres connection ---
PGDATABASE=urlshortener
PGHOST=localhost
PGPORT=5432

# --- Production (Render) provides a single connection string instead. ---
# When DATABASE_URL is set, it takes priority over the PG* vars above.
# DATABASE_URL=postgres://user:password@host:5432/dbname
