# Copy to .env.local for local development (gitignored).
# In production, set these in Vercel → Project → Environment Variables.
#
# Supabase → Project Settings:
#   Data API  → Project URL              → NEXT_PUBLIC_SUPABASE_URL
#   API Keys  → Publishable key          → NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#
# Before first run:
#   1) Execute schema.sql in Supabase SQL Editor
#   2) Enable Email auth + redirect URLs (see README / DEPLOY.md)
#   3) Optional: custom SMTP for password-reset emails
#
# Also configure Authentication → URL Configuration:
#   Site URL: http://localhost:3000  (or your production domain)
#   Redirect URLs: http://localhost:3000/**  (covers /auth/callback)

# Supabase project URL (e.g. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set to true in .env.local to disable rate limiting while developing locally.
# Never set this in production.
NEXT_PUBLIC_IS_DEV=true
